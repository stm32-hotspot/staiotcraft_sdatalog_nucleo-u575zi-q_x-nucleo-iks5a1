{
    "version": 3,
    "configurePresets": [
        {
            "name": "default",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build/${presetName}",
		    "toolchainFile": "${sourceDir}/cmake/gcc-arm-none-eabi.cmake",
            "cacheVariables": {
            }
        },
        {
            "name": "Debug",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "Release",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        },
        {
            "name": "ReleaseSpeed",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -g0",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -g0"
            }
        },
        {
            "name": "ReleaseSize",
            "inherits": "default",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_C_FLAGS_RELEASE": "-Oz -g0 -fno-unwind-tables -fno-asynchronous-unwind-tables -flto",
                "CMAKE_CXX_FLAGS_RELEASE": "-Oz -g0 -fno-unwind-tables -fno-asynchronous-unwind-tables -flto",
                "CMAKE_EXE_LINKER_FLAGS_RELEASE": "-flto"
            }
        }
    ],
    "buildPresets": [
        {
            "name": "Debug",
            "configurePreset": "Debug"
        },
        {
            "name": "Release",
            "configurePreset": "Release"
        },
        {
            "name": "ReleaseSpeed",
            "configurePreset": "ReleaseSpeed"
        },
        {
            "name": "ReleaseSize",
            "configurePreset": "ReleaseSize"
        }
    ]
}